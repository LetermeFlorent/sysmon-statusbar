{
	"name": "sysmon-statusbar",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "0.9.0",
	"publisher": "letermeflorent",
	"license": "MIT",
	"icon": "icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/LetermeFlorent/sysmon-statusbar.git"
	},
	"homepage": "https://github.com/LetermeFlorent/sysmon-statusbar#readme",
	"bugs": {
		"url": "https://github.com/LetermeFlorent/sysmon-statusbar/issues"
	},
	"keywords": [
		"cpu",
		"gpu",
		"disk",
		"memory",
		"ram",
		"swap",
		"monitor",
		"system monitor",
		"resource monitor",
		"performance",
		"status bar"
	],
	"engines": {
		"vscode": "^1.75.0"
	},
	"categories": [
		"Visualization",
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./src/extension.js",
	"extensionKind": [
		"ui"
	],
	"scripts": {
		"test": "node --test \"test/*.test.js\""
	},
	"contributes": {
		"commands": [
			{
				"command": "sysmon.restartProbe",
				"title": "%command.restartProbe%",
				"category": "System Monitor"
			},
			{
				"command": "sysmon.pickCpus",
				"title": "%command.pickCpus%",
				"category": "System Monitor"
			},
			{
				"command": "sysmon.pickGpus",
				"title": "%command.pickGpus%",
				"category": "System Monitor"
			},
			{
				"command": "sysmon.pickDisks",
				"title": "%command.pickDisks%",
				"category": "System Monitor"
			}
		],
		"icons": {
			"sysmon-bar-full": {
				"description": "%icon.barFull%",
				"default": {
					"fontPath": "./bar.woff",
					"fontCharacter": "\\E000"
				}
			},
			"sysmon-bar-empty": {
				"description": "%icon.barEmpty%",
				"default": {
					"fontPath": "./bar.woff",
					"fontCharacter": "\\E001"
				}
			}
		},
		"configuration": {
			"title": "System Monitor",
			"properties": {
				"sysmon.refreshSeconds": {
					"type": "number",
					"default": 2,
					"description": "%config.refreshSeconds%"
				},
				"sysmon.barWidth": {
					"type": "number",
					"default": 5,
					"description": "%config.barWidth%"
				},
				"sysmon.alignment": {
					"type": "string",
					"enum": [
						"left",
						"right"
					],
					"default": "left",
					"description": "%config.alignment%",
					"enumDescriptions": [
						"%config.alignment.left%",
						"%config.alignment.right%"
					]
				},
				"sysmon.showCpu": {
					"type": "boolean",
					"default": true,
					"description": "%config.showCpu%"
				},
				"sysmon.showGpu": {
					"type": "boolean",
					"default": true,
					"description": "%config.showGpu%"
				},
				"sysmon.showDisk": {
					"type": "boolean",
					"default": true,
					"description": "%config.showDisk%"
				},
				"sysmon.showRam": {
					"type": "boolean",
					"default": true,
					"description": "%config.showRam%"
				},
				"sysmon.showSwap": {
					"type": "boolean",
					"default": true,
					"description": "%config.showSwap%"
				},
				"sysmon.ramValue": {
					"type": "string",
					"enum": [
						"used",
						"free"
					],
					"default": "used",
					"description": "%config.ramValue%",
					"enumDescriptions": [
						"%config.ramValue.used%",
						"%config.ramValue.free%"
					]
				},
				"sysmon.diskDevices": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "%config.diskDevices%"
				},
				"sysmon.cpuDevices": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "%config.cpuDevices%"
				},
				"sysmon.gpuDevices": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "%config.gpuDevices%"
				},
				"sysmon.showLabels": {
					"type": "boolean",
					"default": true,
					"description": "%config.showLabels%"
				},
				"sysmon.showBars": {
					"type": "boolean",
					"default": true,
					"description": "%config.showBars%"
				},
				"sysmon.showValues": {
					"type": "boolean",
					"default": true,
					"description": "%config.showValues%"
				},
				"sysmon.probeRestartSeconds": {
					"type": "number",
					"default": 300,
					"description": "%config.probeRestartSeconds%"
				},
				"sysmon.tooltipSeconds": {
					"type": "number",
					"default": 5,
					"description": "%config.tooltipSeconds%"
				},
				"sysmon.shareProbe": {
					"type": "boolean",
					"default": true,
					"description": "%config.shareProbe%"
				},
				"sysmon.pauseWhenUnfocused": {
					"type": "boolean",
					"default": false,
					"description": "%config.pauseWhenUnfocused%"
				},
				"sysmon.unfocusedMultiplier": {
					"type": "number",
					"default": 1,
					"description": "%config.unfocusedMultiplier%"
				}
			}
		}
	},
	"l10n": "./l10n"
}
